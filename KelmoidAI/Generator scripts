    def find_matching_gear(self, gear_type, params):
        """Find the closest matching gear from our parameter sets"""
        best_match = None
        best_score = 0
        
        for gear_name, gear_data in self.gear_parameters["parameterSets"].items():
            if gear_data["Gear_type"] != gear_type:
                continue
                
            score = 0
            for param, value in params.items():
                if param in gear_data and str(gear_data[param]) == str(value):
                    score += 1
            
            if score > best_score:
                best_score = score
                best_match = gear_data
                best_match['name'] = gear_name
        
        return best_match

